# Environment Configuration Template for CT-DFIR-01 (Crime Nexus)

# Application Environment (development / staging / production)
APP_ENV=development

# Feature Toggle: Recidivism Research-Only Track (true / false)
RESEARCH_MODE_ENABLED=true

# Interface Language Default (en / ta)
DEFAULT_LANGUAGE=en

# Application Security Key
SECRET_KEY=change-this-to-a-secure-random-secret-key

# Database Connection (SQLite local path or PostgreSQL URI)
DATABASE_URL=sqlite:///data/crime_nexus.db

# Email / Alerting Provider Configuration
SMTP_HOST=smtp.transactional-provider.com
SMTP_PORT=587
SMTP_USER=alerts@crimenexus.local
SMTP_PASS=secret-password
SMTP_FROM=alerts@crimenexus.local

# ML Engine Resource Limits
H2O_MAX_MEM_SIZE=2G
H2O_NTHREADS=2

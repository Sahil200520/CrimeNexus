# Environment Configuration Template for CT-DFIR-01 (Crime Nexus)
# Copy this file to '.env' and fill in your actual environment parameters.
# NEVER commit actual secret keys or credentials to source control.

# ==========================================
# 1. Application & Feature Environment Flags
# ==========================================
# Application execution environment: development | staging | production
APP_ENV=development

# Feature Toggle: Recidivism Research-Only Track (true | false)
# When set to true, recidivism scoring runs strictly in isolated academic research mode.
RESEARCH_MODE_ENABLED=true

# Default Application Interface Language: en (English) | ta (Tamil)
DEFAULT_LANGUAGE=en

# Application Logging Level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO


# ==========================================
# 2. Security, Cryptography & Privacy Keys
# ==========================================
# Application Security Secret Key (Used for session signing and API authentication)
SECRET_KEY=change-this-to-a-secure-random-secret-key

# Anonymization Salt for PII Hashing (SHA-256 complainant/victim name obfuscation)
ANONYMIZATION_SALT=change-this-to-a-secure-hashing-salt

# Spatial Coordinate Jitter Radius in Meters (Default: 500m to safeguard victim privacy)
SPATIAL_JITTER_METERS=500


# ==========================================
# 3. Database Connection Parameters
# ==========================================
# Database Connection String (SQLite local fallback or PostgreSQL production URI)
DATABASE_URL=sqlite:///data/crime_nexus.db


# ==========================================
# 4. Email & Alerting Provider Configuration
# ==========================================
# SMTP Gateway Configuration for Continuous Feedback & Automated Threshold Alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=app.technicalteam@gmail.com
SMTP_PASS=change-this-to-your-smtp-app-password
SMTP_FROM=app.technicalteam@gmail.com

# Target Email Address for System Quality Alerts & Feedback Notifications
EMAIL_PASSWORD=change-this-to-your-smtp-app-password
ALERT_RECEIVER_EMAIL=vishalkumars.work@gmail.com


# ==========================================
# 5. Machine Learning & H2O AutoML Resource Limits
# ==========================================
# Maximum Java Heap Size allocated for H2O AutoML instance
H2O_MAX_MEM_SIZE=2G

# Number of CPU threads allocated for H2O AutoML processing (-1 for all cores)
H2O_NTHREADS=2
